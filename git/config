# Shared git config for each machine. ~/.config/git/config points here.
# Machine keys (credential helpers, OS options) stay in ~/.gitconfig.
# Each key has the problem that it fixes.
[user]
	# A forge connects a commit to an account by its email. The name is only for display.
	name = jeew
	# GitHub (jeew00) noreply: the default, also for a repo with no remote.
	email = 43456094+jeew00@users.noreply.github.com
# The remote URL selects the email of the other forges. Each forge needs 3 URL forms.
# Paths are relative to this file.
[includeIf "hasconfig:remote.*.url:https://gitlab.com/**"]
	path = identity-gitlab
[includeIf "hasconfig:remote.*.url:ssh://git@gitlab.com/**"]
	path = identity-gitlab
[includeIf "hasconfig:remote.*.url:git@gitlab.com:*/**"]
	path = identity-gitlab
[init]
	defaultBranch = main
[core]
	# Git for Windows sets autocrlf=true, macOS and Linux do not: keep LF on each OS.
	autocrlf = input
	# OS junk and personal agent files stay out of each repo.
	excludesFile = ~/dotfiles/git/ignore
[diff]
	# Clearer diffs: fewer false matches on lines such as "}".
	algorithm = histogram
	# Show moved code as a move, not as a delete and an add.
	colorMoved = zebra
[merge]
	# A conflict also shows the base version.
	conflictStyle = zdiff3
[rerere]
	# Solve a conflict one time, also after the next rebase.
	enabled = true
[rebase]
	# A rebase does not stop when the working tree has changes.
	autoStash = true
[pull]
	ff = only
[push]
	followTags = true
	# The first push of a branch does not need -u.
	autoSetupRemote = true
[fetch]
	prune = true
[branch]
	# Newest branches first.
	sort = -committerdate
[tag]
	# v1.10.0 comes after v1.9.0.
	sort = version:refname
[revert]
	# A revert message names the commit by its subject.
	reference = true
